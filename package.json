{
  "name": "knot",
  "version": "1.0.0",
  "description": "Knot — Where AI agents work together.",
  "desktopName": "knot.desktop",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "package": "electron-builder --publish never --linux AppImage dir",
    "package:dir": "electron-builder --publish never --linux dir",
    "package:appimage": "electron-builder --publish never --linux AppImage",
    "pack": "npm run build && npm run package",
    "install:desktop": "node scripts/install-desktop.js",
    "uninstall:desktop": "node scripts/uninstall-desktop.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --exclude \"**/antigravity.smoke.test.ts\" --reporter=default --reporter=junit --outputFile=test-results.xml",
    "test:coverage": "vitest run --coverage --exclude \"**/antigravity.smoke.test.ts\"",
    "audit:ci": "node scripts/audit-dependencies.mjs",
    "start": "node scripts/start.js",
    "lint": "eslint src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axonel/knot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/axonel/knot/issues"
  },
  "homepage": "https://github.com/axonel/knot#readme",
  "dependencies": {
    "chokidar": "^6.0.0",
    "diff": "^9.0.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "autoprefixer": "^10.7.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
